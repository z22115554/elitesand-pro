# 執行期資料（自動產生）
data/
downloads/
logs/

# 環境設定（每人各自設定，不上傳到 git）
server/config.js

# 系統檔案
.DS_Store
Thumbs.db
dist/
dist-release/

# 打包產物與編輯暫存檔（不進版控）
*.zip
*.tmp.*
*.tmp

# 開發用工作文件（給 Claude/開發者自己看的交接紀錄，不對外公開）
